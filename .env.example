# Copy this file to .env and fill in your own values.
# .env is already in .gitignore — it will never be committed.

# Required for anything beyond local testing:
SECRET_KEY=change-this-to-a-long-random-string

# Optional — enables the AI Assistant chat widget. Free tier, no credit card
# required: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override which Gemini model the assistant uses. Leave this
# blank/commented out and the app will auto-detect a working Flash model
# for your key (Gemini model names change over time, so this is more
# reliable than hardcoding one). Only set this if you want a specific model.
# ASSISTANT_MODEL=gemini-2.5-flash

# Optional — enables "Continue with Google" on the login/register pages.
# Free. Works on localhost for testing. To get these:
#   1. console.cloud.google.com -> create/select a project
#   2. APIs & Services -> OAuth consent screen -> fill in the basics
#   3. APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#      - Application type: Web application
#      - Authorized redirect URI: http://127.0.0.1:5000/auth/google/callback
#        (add your real domain's equivalent once deployed, e.g.
#        https://yourapp.com/auth/google/callback)
#   4. Copy the Client ID and Client Secret it gives you below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — enables "Continue with Apple". Unlike Google, this requires a
# paid Apple Developer account ($99/year) and CANNOT be tested on localhost
# at all — Apple only accepts https:// redirect URIs on a real domain, so
# this only becomes testable once the app is actually deployed. To get these:
#   1. developer.apple.com/account -> Certificates, IDs & Profiles
#   2. Identifiers -> register an App ID with "Sign In with Apple" enabled
#   3. Identifiers -> register a Services ID (this is your APPLE_CLIENT_ID) —
#      configure it with your real domain and callback URL
#      (https://yourapp.com/auth/apple/callback)
#   4. Keys -> create a new key with "Sign In with Apple" enabled, download
#      the .p8 file (only downloadable once!) — its contents go below,
#      and its 10-character Key ID is APPLE_KEY_ID
#   5. Your Team ID is shown top-right on any Apple Developer page
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
